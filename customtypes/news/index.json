{
  "format": "page",
  "id": "news",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Title",
          "placeholder": ""
        },
        "type": "Text"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "category": {
        "config": {
          "label": "Category",
          "options": [
            "Raid",
            "News",
            "Event",
            "Announcement"
          ],
          "placeholder": ""
        },
        "type": "Select"
      },
      "featured": {
        "config": {
          "default_value": false,
          "label": "Featured",
          "placeholder_false": "false",
          "placeholder_true": "true"
        },
        "type": "Boolean"
      },
      "description": {
        "config": {
          "label": "Description",
          "placeholder": "Short Description for News Feed"
        },
        "type": "Text"
      },
      "author": {
        "config": {
          "default_value": "Mali",
          "label": "Author",
          "options": [
            "Mali",
            "Qyleth",
            "Lasoop"
          ],
          "placeholder": "Since we don't have users..."
        },
        "type": "Select"
      },
      "slices": {
        "config": {
          "choices": {
            "chapter_intro": {
              "type": "SharedSlice"
            },
            "testimonial": {
              "type": "SharedSlice"
            },
            "image_card_grid": {
              "type": "SharedSlice"
            },
            "cta_banner": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "News",
  "repeatable": true,
  "status": true
}