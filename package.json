  },
  "license": "MIT",
  "author": "Jesse Beck",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "nuxt build",
    "build:worker": "NITRO_PRESET=cloudflare_module nuxt build",
    "dev": "nuxt dev",
    "deploy": "pnpm build:worker && wrangler deploy --cwd .output",
