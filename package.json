{
  "name": "eif-website",
  "version": "1.0.0",
  "description": "World of Warcraft Guild Website",
  "keywords": [
    "WoW",
    "World",
    "of",
    "Warcarft"
  ],
  "homepage": "https://github.com/thewebbeckons/eif-website#readme",
  "bugs": {
    "url": "https://github.com/thewebbeckons/eif-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thewebbeckons/eif-website.git"
  },
  "license": "MIT",
  "author": "Jesse Beck",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:worker": "NITRO_PRESET=cloudflare_module nuxt build",
    "dev": "nuxt dev",
    "deploy": "pnpm build:worker && wrangler deploy --cwd .output",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:worker": "pnpm build:worker && wrangler dev --cwd .output",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/content": "^3.15.2",
    "@nuxt/scripts": "^1.3.4",
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "unenv": "2.0.0-rc.24",
    "vue-tsc": "~3.2.9",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
