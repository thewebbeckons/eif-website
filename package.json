{
  "name": "eif-website",
  "version": "1.0.0",
  "description": "World of Warcraft Guild Website",
  "keywords": [
    "WoW",
    "World",
    "of",
    "Warcraft"
  ],
  "homepage": "https://github.com/thewebbeckons/eif-website#readme",
  "bugs": {
    "url": "https://github.com/thewebbeckons/eif-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thewebbeckons/eif-website.git"
  },
  "license": "MIT",
  "author": "Jesse Beck",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:worker": "NITRO_PRESET=cloudflare_module nuxt build",
    "dev": "nuxt dev",
    "deploy": "pnpm build:worker && wrangler deploy --cwd .output",
    "generate": "nuxt generate",
    "prismic:pull": "npx prismic pull",
    "prismic:sync": "npx prismic sync --watch",
    "prismic:types": "npx prismic gen types",
    "preview": "nuxt preview",
    "preview:worker": "pnpm build:worker && wrangler dev --cwd .output",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "worker:types": "pnpm build:worker && wrangler types worker-configuration.d.ts --config .output/server/wrangler.json --include-runtime false",
    "wisdom:generate": "tsx scripts/generate-wisdom.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "^0.10.8",
    "@prismicio/client": "^7.21.8",
    "@prismicio/vue": "^6.1.3",
    "@vueuse/core": "^14.3.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.4.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260718.1",
    "@iconify-json/lucide": "^1.2.118",
    "@nuxtjs/prismic": "^5.3.0",
    "ai": "^7.0.31",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.9",
    "wrangler": "^4.112.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
