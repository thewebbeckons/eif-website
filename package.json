    "@nuxthub/core": "^0.10.8",
    "motion-v": "^2.4.0",
    "nuxt": "^4.5.2",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxtjs/prismic": "^5.3.0",
    "@oxc-minify/binding-darwin-arm64": "^0.144.0",
    "@oxc-parser/binding-darwin-arm64": "^0.144.0",
    "@oxc-transform/binding-darwin-arm64": "^0.144.0",
    "@prismicio/client": "^7.22.0",
    "@prismicio/vue": "^6.1.3",
    "@slicemachine/adapter-nuxt": "^0.3.98",
    "rolldown": "~1.2.4",
    "slice-machine-ui": "^2.21.5",
    "typescript": "~5.9.3",
